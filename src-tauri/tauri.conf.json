{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typing Trainer",
  "version": "0.1.0",
  "identifier": "com.drmin.typing-fun",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "打字训练",
        "width": 1200,
        "height": 840,
        "minWidth": 980,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
